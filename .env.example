# Copy to .env and fill in (never commit .env)
ANTHROPIC_API_KEY=
# Notion integration token (read-only), from notion.so/profile/integrations
NOTION_TOKEN=
# Spotify app Client ID (PKCE, no secret needed), from developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
# Telegram bot token from @BotFather (then run backend/telegram_client.py to link your chat)
TELEGRAM_BOT_TOKEN=
